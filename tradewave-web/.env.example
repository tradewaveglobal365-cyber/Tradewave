# The API runs on 4001 because another local project (sterling-v2) owns 4000.
#
# Local: absolute, the browser calls the API directly (localhost is same-site).
# Production on Vercel: set this to the relative path "/api/v1" so the browser
# talks only to the Vercel origin and next.config.ts rewrites through to the API.
# That keeps the session cookie first-party.
NEXT_PUBLIC_API_URL=http://localhost:4001/api/v1

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Production only — the deployed API origin, e.g. https://tradewave-api.onrender.com
# (no trailing slash, no /api/v1). Drives both the rewrite destination and
# server-side fetches, which need an absolute URL. Leave unset locally.
# API_ORIGIN=
