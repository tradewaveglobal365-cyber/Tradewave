// Tradewave — Phase 1 schema (auth + referral capture)
// Contract mirror: src/modules/*/schemas.ts

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  /// Can sign in and read everything, but cannot move money — no deposit, no
  /// investment, no withdrawal, no payout-account change, no identity check.
  ///
  /// Deliberately NOT the same as SUSPENDED. Locking somebody out of an
  /// investment account while you look into something is indistinguishable,
  /// from where they sit, from being robbed. Letting them see their money is
  /// still there turns an investigation into a support conversation.
  RESTRICTED
  /// Cannot sign in at all. login() refuses before the password is checked.
  SUSPENDED
}

enum Role {
  USER
  ADMIN
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

/// Identity verification is deliberately NOT folded into UserStatus. A user can be
/// ACTIVE (email confirmed) and un-verified at the same time — one enum cannot hold
/// both, and a KYC rejection must not clobber state that email verification owns.
enum KycStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  REJECTED
  /// Provider never answered, or the session timed out. Retryable, and
  /// deliberately distinct from REJECTED: a timeout is not a failed check, must
  /// not read as one to the user, and must not consume a retry.
  EXPIRED
}

/// Reported by the provider from the document it verified — not chosen by the user.
/// OTHER is the catch-all so an unrecognised type is recorded rather than dropped.
enum DocumentType {
  NIN
  NATIONAL_ID
  PASSPORT
  DRIVERS_LICENSE
  VOTERS_CARD
  RESIDENCE_PERMIT
  EMIRATES_ID
  OTHER
}

enum PropertyStatus {
  DRAFT
  OPEN
  FUNDED
  CLOSED
}

enum InvestmentStatus {
  ACTIVE
  MATURED
  CANCELLED
}

enum DepositStatus {
  PENDING
  SUCCESS
  FAILED
  ABANDONED
}

/**
 * Money on its way OUT.
 * The dollars leave the wallet at REQUESTED, not at PAID. A balance that still
 * shows money somebody has already asked to withdraw is the bug that lets the
 * same dollars be withdrawn and invested at once.
 * REJECTED, FAILED and CANCELLED all return the money and differ only in who
 * decided: us, the provider, or the investor.
 */
enum WithdrawalStatus {
  REQUESTED
  APPROVED
  PAID
  REJECTED
  FAILED
  CANCELLED
}

enum LedgerEntryType {
  DEPOSIT
  INVESTMENT
  RETURN_PAYOUT
  REFERRAL_BONUS
  WITHDRAWAL
  ADJUSTMENT
}

model User {
  id           String  @id @default(uuid()) @db.Uuid
  email        String  @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  country      String  @default("AE")

  status          UserStatus @default(PENDING_VERIFICATION)
  role            Role       @default(USER)
  emailVerifiedAt DateTime?
  kycStatus       KycStatus  @default(NOT_STARTED)
  kycVerifiedAt   DateTime?

  /// When an admin last sent this user back through identity verification.
  ///
  /// The attempt caps in kyc.service count submissions since this moment, so a
  /// decision WE made does not spend an allowance the investor never used.
  kycResetAt DateTime?

  /// Set while withdrawals are blocked for this investor specifically.
  ///
  /// Narrower than RESTRICTED on purpose: stopping somebody taking money out
  /// while a payment is disputed should not also stop them investing or seeing
  /// their account.
  withdrawalsBlockedAt DateTime?

  // Referral — written in the same transaction as user creation, never updated after.
  referralCode String    @unique
  referredById String?   @db.Uuid
  referredBy   User?     @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals    User[]    @relation("Referrals")
  referredAt   DateTime?

  // Lockout
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?

  sessions       Session[]
  tokens         VerificationToken[]
  wallet         Wallet?
  investments    Investment[]
  deposits       Deposit[]
  depositAccount DepositAccount?
  payoutAccount  PayoutAccount?
  withdrawals    Withdrawal[]

  adminActionsPerformed AdminAction[]     @relation("AdminActionsPerformed")
  adminActionsReceived  AdminAction[]     @relation("AdminActionsReceived")
  kycVerifications      KycVerification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([referredById])
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique // sha256 of the raw token; the raw value is never stored
  familyId         String    @db.Uuid // rotation lineage, for reuse detection
  expiresAt        DateTime
  revokedAt        DateTime?
  userAgent        String?
  ipAddress        String?
  createdAt        DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

model VerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  type       TokenType
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, type])
}

/// One row per verification attempt, rather than only a status field on User.
/// Retry-after-rejection needs history, webhooks need providerRef to stay
/// idempotent under retry, and "which document did they pass with" is an audit
/// question that eventually gets asked.
model KycVerification {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Which driver produced this decision: "stub" today, a vendor name later.
  provider    String
  /// The vendor's own id for the attempt. Unique so a replayed webhook cannot
  /// apply twice. Null under the stub driver, which has no remote counterpart.
  providerRef String? @unique

  /// All three are null until the provider returns a decision: the user no longer
  /// types a document number, so nothing is known at submit time. They are filled
  /// from the document the provider actually verified.
  documentType  DocumentType?
  /// Display only, e.g. "4821" rendered as ****4821.
  documentLast4 String?
  /// Keyed HMAC of the number the provider READ off the verified document — a
  /// stronger dedupe key than a self-typed one. The raw value is never stored.
  documentHash  String?

  status          KycStatus
  /// The provider's own word for where this sits, verbatim, e.g. "In Review",
  /// "In Progress", "Approved". Several of those collapse into our PENDING, and
  /// the difference between "In Review" and "In Progress" is the difference
  /// between waiting on US and waiting on the USER — which decides both what we
  /// tell the investor and what appears in the admin review queue.
  providerStatus  String?
  rejectionReason String?

  /// Where to send the user to finish. Kept so an abandoned session can be
  /// resumed rather than paying for a brand new one.
  redirectUrl String?

  /// Audit trail. The provider holds the images; we keep only the scores that
  /// justify the decision.
  livenessScore  Float?
  faceMatchScore Float?

  submittedAt DateTime  @default(now())
  expiresAt   DateTime?
  decidedAt   DateTime?

  /// Throttles reconciliation. Polling a paid API is not free.
  lastPolledAt DateTime?
  pollCount    Int       @default(0)

  @@index([userId, status])
  @@index([documentHash])
}

model LoginAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  email     String
  ipAddress String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 2 — properties, wallet, fractional investment
//
// All money is an integer number of US CENTS held as BigInt. Never a float, never a
// JS number in this layer. See src/lib/money.ts for the reasoning.
// ─────────────────────────────────────────────────────────────────────────────

model Property {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  title       String
  summary     String
  description String
  addressLine String
  area        String // e.g. "Downtown Dubai"
  city        String // e.g. "Dubai"
  country     String   @default("AE")
  images      String[]

  totalValueCents    BigInt
  minInvestmentCents BigInt
  // Denormalised funding total. ONLY ever written inside the invest
  // transaction, via a conditional UPDATE that cannot oversubscribe.
  fundedCents        BigInt @default(0)

  annualReturnBps Int // 1800 = 18.00% per annum
  termMonths      Int

  status          PropertyStatus @default(DRAFT)
  fundingClosesAt DateTime?

  investments Investment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Investment {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id])

  principalCents BigInt

  // Snapshot of the property terms at purchase time — deliberately NOT read
  // back from Property. Editing a property's rate later must never change the
  // terms an existing investor already agreed to.
  annualReturnBps Int
  termMonths      Int

  status     InvestmentStatus @default(ACTIVE)
  investedAt DateTime         @default(now())
  maturesAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([propertyId])
}

model Wallet {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Cached balance. NEVER written outside the same transaction as its
  // LedgerEntry — a balance that has drifted from its history is unauditable.
  balanceCents BigInt @default(0)

  entries LedgerEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LedgerEntry {
  id       String @id @default(uuid()) @db.Uuid
  walletId String @db.Uuid
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  type              LedgerEntryType
  amountCents       BigInt // signed: credit positive, debit negative
  balanceAfterCents BigInt // snapshot, so a row can be audited in isolation

  // Idempotency key. A replayed payment webhook cannot double-credit, because
  // the second insert violates this constraint at the database level.
  reference   String @unique
  description String

  investmentId String? @db.Uuid
  depositId    String? @db.Uuid
  withdrawalId String? @db.Uuid

  createdAt DateTime @default(now())

  @@index([walletId, createdAt])
}

// The naira account a user transfers into. One per user, permanent once created:
// Klasha issues a dedicated account keyed on the customer's email, so the number
// a user memorises keeps working for every future deposit.
model DepositAccount {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider    String  @default("klasha")
  providerRef String?

  // Shown to the user verbatim. Stored rather than re-fetched on every page
  // load: it never changes, and a wallet screen that cannot render because the
  // provider is slow is worse than one showing details we already hold.
  accountNumber String
  accountName   String
  bankName      String
  bankCode      String?
  currency      String  @default("NGN")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountNumber])
}

// Where money leaves to. One per user, replaced in place rather than versioned:
// there is a single destination, so there is no history to reconcile and no
// "which account?" step when a withdrawal is eventually built.
model PayoutAccount {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider String @default("klasha")

  bankCode      String
  bankName      String
  // Stored whole because a payout needs it; shown masked to the user. A Nigerian
  // account number is not secret the way a card number is, but it is still the
  // thing an attacker would swap to redirect money.
  accountNumber String
  accountName   String

  // Whether the name was confirmed by the BANK (NIBSS name enquiry) or merely
  // asserted by the user. False when the provider could not answer — an unknown
  // account number, or the stub driver — so this is how you tell which accounts
  // were taken on trust.
  nameResolved Boolean @default(false)

  // When the DESTINATION last changed, which is not the same as when the row
  // last changed. Withdrawals are held for 24 hours after a change, and
  // updatedAt would restart that clock when somebody re-saves the same account
  // unchanged — punishing a no-op and teaching users the hold is arbitrary.
  destinationChangedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Money leaving, from the request to the naira landing.
//
// Mirrors Deposit deliberately: an amount in the ledger currency, a status, a
// provider reference that is unique so a retry cannot send twice, and the
// source figure with the rate it was converted at pinned alongside it. Reading
// the two models side by side should make both obvious.
/**
 * When investors are allowed to ASK for money.
 * A single row, edited in place. Payouts run on a schedule rather than
 * continuously, and the request is gated to the same window on purpose: money
 * that leaves a balance on Tuesday and reaches a bank on Friday reads as
 * somebody holding your money, however carefully it is explained. Requesting
 * and being paid on the same day is the honest version of a weekly payout.
 * This gates the INVESTOR's request only. Staff can approve and send at any
 * hour — otherwise a request made ten minutes before closing could not be
 * finished, which is the opposite of the point.
 */
model WithdrawalWindow {
  // Single row. A fixed id rather than "the first row you find", so there is
  // no way to end up with two schedules disagreeing about today.
  id String @id @default("singleton")

  /**
   * Off means no schedule at all: requests are accepted at any time.
   */
  enabled Boolean @default(true)

  /**
   * 0 = Sunday through 6 = Saturday. Defaults to Friday.
   */
  daysOfWeek Int[] @default([5])

  // Minutes from midnight, in `timezone`. 09:00 to 17:00.
  opensAtMinute  Int @default(540)
  closesAtMinute Int @default(1020)

  /**
   * IANA zone. Lagos, not UTC — a "Friday" computed in UTC actually runs from
   * 01:00 Friday to 01:00 Saturday for everyone using this product.
   */
  timezone String @default("Africa/Lagos")

  /// Stops ALL withdrawals, for everybody, regardless of the schedule above.
  ///
  /// Separate from `enabled`, which only turns the day-and-time restriction off
  /// — the two mean opposite things and collapsing them would make "no
  /// schedule" and "nothing may leave" the same switch.
  paused       Boolean @default(false)
  /// Shown to investors. A pause with no explanation is the shape of a scam.
  pausedReason String?

  updatedAt       DateTime @updatedAt
  updatedByUserId String?  @db.Uuid
}

/// What staff did to whom, and why.
///
/// Append-only. Nothing updates or deletes a row — the same shape FxRate uses,
/// for the same reason its comment gives: a bad edit has to stay recoverable.
///
/// Three actor columns already existed before this (Withdrawal.decidedByUserId,
/// WithdrawalWindow.updatedByUserId, FxRate.setByUserId) and each keeps only the
/// LAST actor for one row. None of them can answer "who froze this person, and
/// why" — which is a question that eventually gets asked by somebody who is
/// angry, and sometimes by a regulator.
model AdminAction {
  id   String          @id @default(uuid()) @db.Uuid
  type AdminActionType

  actorId String @db.Uuid
  actor   User   @relation("AdminActionsPerformed", fields: [actorId], references: [id])

  /// Null for platform-wide actions, which have no single subject.
  subjectId String? @db.Uuid
  subject   User?   @relation("AdminActionsReceived", fields: [subjectId], references: [id])

  /// Mandatory. The investor is told this for anything that affects them, so it
  /// is written to be read by them rather than as an internal note.
  reason String

  /// Whatever else the action needs recorded, e.g. {"amountCents":"-5000"}.
  detail Json?

  createdAt DateTime @default(now())

  @@index([subjectId, createdAt])
  @@index([actorId, createdAt])
}

enum AdminActionType {
  SUSPEND
  REINSTATE
  RESTRICT
  UNRESTRICT
  BLOCK_WITHDRAWALS
  UNBLOCK_WITHDRAWALS
  FORCE_KYC_REVERIFICATION
  ADJUST_BALANCE
  VERIFY_EMAIL
  PAUSE_WITHDRAWALS
  RESUME_WITHDRAWALS
}

model Withdrawal {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // What left the wallet. The fee is taken OUT of this, not added on top, so
  // amountCents is both what the investor asked for and what they were debited.
  amountCents BigInt
  feeCents    BigInt @default(0)

  status WithdrawalStatus @default(REQUESTED)

  // The destination, snapshotted at request time. PayoutAccount is replaced in
  // place, so reading the bank off the relation would rewrite history every
  // time somebody changes where they bank.
  bankCode      String
  bankName      String
  accountNumber String
  accountName   String

  // Naira, pinned when the transfer is actually sent rather than when it is
  // asked for — the same moment a deposit's rate is pinned. Null until then,
  // which is why the investor is shown an estimate up to that point.
  destinationAmountMinor BigInt?
  rateMinorPerUnit       BigInt?

  provider String @default("klasha")

  // Ours, sent as Klasha's requestId. Unique, so a double-approve cannot become
  // a double-payment: the second insert loses to the constraint.
  requestId String @unique

  // Theirs. Klasha's payout webhook identifies a transfer by its own reference
  // rather than echoing ours back, so this is the only thing that can match one.
  providerRef String? @unique

  failureReason   String?
  rejectionReason String?

  requestedAt     DateTime  @default(now())
  decidedAt       DateTime?
  paidAt          DateTime?
  decidedByUserId String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, requestedAt])
  @@index([status, requestedAt])
}

model Deposit {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  amountCents BigInt
  status      DepositStatus @default(PENDING)
  provider    String        @default("klasha")

  // Klasha's tnxRef. Unique, so a replayed webhook cannot double-credit: the
  // second insert fails at the database rather than relying on a code path
  // remembering to check.
  providerRef String @unique

  // What actually arrived, and the rate applied to it. Pinned at receipt so a
  // later rate change can never restate a deposit that already happened —
  // without these two columns the credited figure is unexplainable after the
  // admin next moves the rate.
  sourceAmountMinor BigInt?
  sourceCurrency    String  @default("NGN")
  rateMinorPerUnit  BigInt?

  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}

// Append-only rate history rather than one mutable row, so a historical display
// can be reproduced and a bad rate edit is recoverable.
//
// This holds USD -> NGN only. The AED figure shown on property pages is NOT in
// here: the dirham is pegged to the dollar, so it is a constant in lib/money.ts
// rather than a rate anyone has to keep current.
//
// The stored rate is the CUSTOMER rate, spread already applied — the number the
// user was quoted and the number they are credited at. `midMinorPerUnit` keeps
// the market rate it was derived from, so the spread earned on any deposit is
// reconstructable after the fact.
model FxRate {
  id              String   @id @default(uuid()) @db.Uuid
  baseCurrency    String   @default("USD")
  quoteCurrency   String   @default("NGN")
  // Kobo per 1 USD: ₦1,650.00/$ is 165_000. No extra scale factor — a kobo is
  // already finer than any rate a treasury desk would publish.
  minorPerUnit    BigInt
  midMinorPerUnit BigInt?
  setByUserId     String?  @db.Uuid
  effectiveAt     DateTime @default(now())

  @@index([baseCurrency, quoteCurrency, effectiveAt])
}
