# ── Database ─────────────────────────────────────────────────────────────────
# Supabase gives you two connection strings. Both are required.
#   DATABASE_URL — pooled (PgBouncer, port 6543). Used by the app at runtime.
#   DIRECT_URL   — direct   (port 5432).          Used by prisma migrate/studio.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET="replace-me-with-a-48-byte-random-secret"

# ── Email ────────────────────────────────────────────────────────────────────
# Leave RESEND_API_KEY empty to use the console email driver (prints links to stdout).
RESEND_API_KEY=""
EMAIL_FROM="Tradewave <noreply@your-verified-domain.com>"

# ── Identity verification (Didit) ─────────────────────────────────────────────
# Leave all three empty to use the stub driver (auto-approves outside production).
# Set all three together — the API refuses to boot half-configured, because
# sessions would start that no decision could ever resolve.
#   DIDIT_API_KEY        business.didit.me → your Application → API & Webhooks
#   DIDIT_WORKFLOW_ID    the published workflow with Nigeria NIN lookup + liveness
#   DIDIT_WEBHOOK_SECRET secret_shared_key, shown ONCE when you create the
#                        webhook destination pointing at /api/v1/kyc/webhook
DIDIT_API_KEY=""
DIDIT_WORKFLOW_ID=""
DIDIT_WEBHOOK_SECRET=""

# Peppers the hash of government ID numbers. Generate with: openssl rand -base64 48
# Required (>=32 chars) in production. Rotating it orphans every existing hash.
KYC_ID_PEPPER=""

# ── App ──────────────────────────────────────────────────────────────────────
WEB_ORIGIN="http://localhost:3000"
COOKIE_DOMAIN=""
PORT=4001
NODE_ENV="development"
