# ── Database ─────────────────────────────────────────────────────────────────
# Supabase gives you two connection strings. Both are required.
#   DATABASE_URL — pooled (PgBouncer, port 6543). Used by the app at runtime.
#   DIRECT_URL   — direct   (port 5432).          Used by prisma migrate/studio.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET="replace-me-with-a-48-byte-random-secret"

# ── Email ────────────────────────────────────────────────────────────────────
# Leave RESEND_API_KEY empty to use the console email driver (prints links to stdout).
RESEND_API_KEY=""
EMAIL_FROM="Tradewave <noreply@your-verified-domain.com>"
# Where replies land. Several emails invite one — an account freeze, a balance
# adjustment — and without this they go to noreply@ and vanish.
EMAIL_REPLY_TO="support@your-verified-domain.com"

# ── Identity verification (Didit) ─────────────────────────────────────────────
# Leave all three empty to use the stub driver (auto-approves outside production).
# Set all three together — the API refuses to boot half-configured, because
# sessions would start that no decision could ever resolve.
#   DIDIT_API_KEY        business.didit.me → your Application → API & Webhooks
#   DIDIT_WORKFLOW_ID    the published workflow: document capture + passive liveness
#                        + face match + IP analysis. All four are free-tier
#                        (500/month each); the NIN registry lookup is NOT free and
#                        is deliberately disabled on the workflow.
#   DIDIT_WEBHOOK_SECRET secret_shared_key, shown ONCE when you create the
#                        webhook destination pointing at /api/v1/kyc/webhook
DIDIT_API_KEY=""
DIDIT_WORKFLOW_ID=""
DIDIT_WEBHOOK_SECRET=""

# ── Deposits (Klasha) ────────────────────────────────────────────────────────
# Leave all four empty to use the stub driver: it issues a fake account number
# outside production so the funding screen can be demoed, and refuses to issue
# anything in production.
#
# Set all four together — the API refuses to boot half-configured, because we
# would hand a user an account number and then be unable to confirm what lands
# in it. Money would arrive and nothing would credit it.
#
#   KLASHA_BASE_URL           https://dev.kcookery.com  (sandbox)
#                             https://gate.klasapps.com  (live)
#                             HOST ONLY — no path. "/pay" belongs to one
#                             endpoint in their docs, not to the base, and the
#                             API refuses to boot with a path here.
#   KLASHA_PUBLIC_KEY         dashboard -> Settings -> Generate API keys
#   KLASHA_ENCRYPTION_KEY     the same page. EXACTLY 24 bytes — several of
#                             Klasha's endpoints take a 3DES-encrypted body.
#   KLASHA_ACCOUNT_EMAIL      their bearer token is minted from ACCOUNT
#   KLASHA_ACCOUNT_PASSWORD   credentials rather than a machine credential.
#                             Ask them for a scoped API credential; dashboard
#                             login details in deployment config is their
#                             design, and not a good one.
KLASHA_BASE_URL="https://dev.kcookery.com"
KLASHA_PUBLIC_KEY=""
KLASHA_ENCRYPTION_KEY=""
KLASHA_ACCOUNT_EMAIL=""
KLASHA_ACCOUNT_PASSWORD=""
#   KLASHA_BUSINESS_ID        dashboard -> Settings. Only WITHDRAWALS need it:
#                             it sits in the path of the payout endpoint.
#                             Deposits work without it, so it is not part of
#                             the all-or-nothing group above.
KLASHA_BUSINESS_ID=""

# Peppers the hash of government ID numbers. Generate with: openssl rand -base64 48
# Required (>=32 chars) in production. Rotating it orphans every existing hash.
KYC_ID_PEPPER=""

# ── Listing photographs (Supabase Storage) ───────────────────────────────────
# Both together or neither. Without them the admin can still manage every other
# part of a property; only the image upload answers 503.
#
# The bucket must exist and be PUBLIC-READ — listing photographs are shown to
# logged-out visitors on the marketing page.
#
# ⚠️ SUPABASE_SERVICE_ROLE_KEY bypasses row-level security and can read and write
# the whole database. Same handling as the Klasha password: deployment config
# only, never a browser, never committed.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_PROPERTY_BUCKET="property-images"

# ── App ──────────────────────────────────────────────────────────────────────
# Which local currency investors fund and withdraw in: NGN or GHS.
# Drives the Klasha account currency, the FX quote currency, the payout bank
# list and the payout itself together, so they cannot drift apart.
COLLECTION_CURRENCY="NGN"

WEB_ORIGIN="http://localhost:3000"
COOKIE_DOMAIN=""
PORT=4001
NODE_ENV="development"
